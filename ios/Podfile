def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end
node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

workspace 'BlueWallet'
platform :ios, min_ios_version_supported
prepare_react_native_project!
setup_permissions(['Camera', 'Notifications'])
linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# Define a common function to configure shared settings for targets
def configure_target()
  config = use_native_modules!

  use_react_native!(
    # Specify the path directly if use_native_modules! does not provide it
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/.."

  )
  pod 'react-native-bw-file-access', :path => '../blue_modules/react-native-bw-file-access'
end


target 'BlueWallet' do
  configure_target()
end

# Repair Mac Catalyst slices of RN prebuilt xcframeworks.
# See scripts/fix-mac-catalyst-prebuilt-frameworks.sh and
# https://github.com/facebook/react-native/issues/55540
MAC_CATALYST_PREBUILT_FIX_SCRIPT = File.expand_path('../scripts/fix-mac-catalyst-prebuilt-frameworks.sh', __dir__)
MAC_CATALYST_PREBUILT_FIX_PHASE_NAME = '[BlueWallet] Fix Mac Catalyst prebuilt frameworks'

def run_mac_catalyst_prebuilt_fix!(pods_root)
  unless File.executable?(MAC_CATALYST_PREBUILT_FIX_SCRIPT) || File.exist?(MAC_CATALYST_PREBUILT_FIX_SCRIPT)
    Pod::UI.warn "Mac Catalyst prebuilt fix script missing: #{MAC_CATALYST_PREBUILT_FIX_SCRIPT}"
    return
  end
  system('bash', MAC_CATALYST_PREBUILT_FIX_SCRIPT, pods_root.to_s)
end

# RN's replace-*-version.js scripts re-extract Debug/Release tarballs before
# compile and wipe the post_install repair. Re-apply on the same pod targets
# after those script phases.
def install_mac_catalyst_prebuilt_fix_build_phases!(installer)
  targets = installer.pods_project.targets.select do |target|
    %w[React-Core-prebuilt ReactNativeDependencies hermes-engine].include?(target.name)
  end
  return if targets.empty?

  targets.each do |target|
    existing = target.shell_script_build_phases.find { |phase| phase.name == MAC_CATALYST_PREBUILT_FIX_PHASE_NAME }
    phase = existing || target.new_shell_script_build_phase(MAC_CATALYST_PREBUILT_FIX_PHASE_NAME)
    phase.shell_script = "bash \"#{MAC_CATALYST_PREBUILT_FIX_SCRIPT}\" \"${PODS_ROOT}\"\n"
    # Always re-run: Debug↔Release prebuilt swaps rewrite the xcframeworks.
    if phase.respond_to?(:always_out_of_date=)
      phase.always_out_of_date = '1'
    end
  end
  installer.pods_project.save
end

post_install do |installer|
  react_native_post_install(
    installer,
    :mac_catalyst_enabled => true,
    :ccache_enabled => ENV['USE_CCACHE'] == '1',
  )
  # Fix RCTDeprecation module map error with Xcode 16+/26+ (required for react-native-notifications).
  # The bridging header imports RCTBridgeModule.h which does
  # #import <RCTDeprecation/RCTDeprecation.h>. With -fmodules, Clang treats this
  # as a module import and builds a PCM, but PCH verification then fails with
  # "module 'RCTDeprecation' is not defined in any loaded module map file".
  # Fix: remove RCTDeprecation -fmodule-map-file from the consumer xcconfigs
  # so the import resolves as a plain textual include via HEADER_SEARCH_PATHS.
  # No code uses @import RCTDeprecation, so this is safe.
  installer.generated_aggregate_targets.each do |aggregate_target|
    aggregate_target.xcconfigs.each do |config_name, config|
      xcconfig_path = aggregate_target.xcconfig_path(config_name)
      content = File.read(xcconfig_path)
      # Order matters: match -Xcc variant first to avoid leaving a dangling -Xcc
      content.gsub!('-Xcc -fmodule-map-file="${PODS_ROOT}/Headers/Public/RCTDeprecation/RCTDeprecation.modulemap" ', '')
      content.gsub!('-fmodule-map-file="${PODS_ROOT}/Headers/Public/RCTDeprecation/RCTDeprecation.modulemap" ', '')
      File.write(xcconfig_path, content)
    end
  end

  # Mac Catalyst + RN prebuilts (RN 0.84+): repair framework symlinks after pod
  # install, and install build phases so Debug/Release tarball swaps stay fixed.
  run_mac_catalyst_prebuilt_fix!(installer.sandbox.root)
  install_mac_catalyst_prebuilt_fix_build_phases!(installer)
end
