      }
    },
    "share_ui_processing_message" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Looking for a QR code in the selected image." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Buscando un código QR en la imagen seleccionada." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Recherche d’un code QR dans l’image sélectionnée." } }
      }
    },
