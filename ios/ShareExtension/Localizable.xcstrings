{
  "sourceLanguage" : "en",
  "strings" : {
    "share_error_could_not_open" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "BlueWallet could not be opened." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo abrir BlueWallet." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible d’ouvrir BlueWallet." } }
      }
    },
    "share_error_image_too_large" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The shared image is too large." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La imagen compartida es demasiado grande." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’image partagée est trop volumineuse." } }
      }
    },
    "share_error_image_dimensions_too_large" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The shared image has dimensions that are too large. Choose an image smaller than 16 megapixels." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Las dimensiones de la imagen compartida son demasiado grandes. Elige una imagen de menos de 16 megapíxeles." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les dimensions de l’image partagée sont trop grandes. Choisissez une image de moins de 16 mégapixels." } }
      }
    },
    "share_error_import_failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "BlueWallet couldn’t scan this image for a QR code." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "BlueWallet no pudo buscar un código QR en esta imagen." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "BlueWallet n’a pas pu rechercher de code QR dans cette image." } }
      }
    },
    "share_error_qr_not_found" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "No QR code was found in the shared image." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se encontró ningún código QR en la imagen compartida." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun code QR n’a été trouvé dans l’image partagée." } }
      }
    },
    "share_error_storage_unavailable" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "BlueWallet shared storage is unavailable." } },
