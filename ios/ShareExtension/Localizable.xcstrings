        "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre el código QR detectado en BlueWallet." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvre le code QR détecté dans BlueWallet." } }
