        "en" : { "stringUnit" : { "state" : "translated", "value" : "Share one supported image at a time." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Comparte una imagen compatible a la vez." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Partagez une seule image compatible à la fois." } }
