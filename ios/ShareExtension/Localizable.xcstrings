        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le stockage partagé de BlueWallet est indisponible." } }
      }
    },
    "share_error_unreadable_image" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The shared image could not be read." } },
