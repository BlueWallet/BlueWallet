      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Scanning image" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Escaneando imagen" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Analyse de l’image" } }
      }
    },
    "share_ui_qr_preview" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Detected QR code preview" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Vista previa del código QR detectado" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aperçu du code QR détecté" } }
      }
    },
    "share_recovery_import_failed" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open the image in Photos, take a screenshot, crop it closely around the QR code, then share the screenshot to BlueWallet." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre la imagen en Fotos, haz una captura, recórtala alrededor del código QR y comparte la captura con BlueWallet." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrez l’image dans Photos, faites une capture d’écran, recadrez-la autour du code QR, puis partagez-la avec BlueWallet." } }
      }
    },
    "share_recovery_image_too_large" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "In Photos, crop the image closely around the QR code or take a screenshot, then share the smaller image again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "En Fotos, recorta la imagen alrededor del código QR o haz una captura y vuelve a compartir la imagen más pequeña." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Dans Photos, recadrez l’image autour du code QR ou faites une capture d’écran, puis partagez l’image réduite." } }
      }
    },
    "share_recovery_open_bluewallet" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open BlueWallet once, return to Photos, select one image, tap Share, then choose BlueWallet again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Abre BlueWallet una vez, vuelve a Fotos, selecciona una imagen, toca Compartir y elige BlueWallet de nuevo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ouvrez BlueWallet une fois, revenez dans Photos, sélectionnez une image, touchez Partager, puis choisissez à nouveau BlueWallet." } }
      }
    },
    "share_recovery_qr_not_found" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Use a sharp image with one complete QR code. Crop away surrounding text and buttons, then share it again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Usa una imagen nítida con un solo código QR completo. Recorta el texto y los botones que lo rodean y vuelve a compartirla." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utilisez une image nette contenant un seul code QR complet. Recadrez le texte et les boutons autour, puis partagez-la à nouveau." } }
      }
    },
    "share_recovery_unreadable_image" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "In Photos, tap Share, tap Options, choose Most Compatible, then share the image to BlueWallet again." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "En Fotos, toca Compartir, toca Opciones, elige Más compatible y vuelve a compartir la imagen con BlueWallet." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Dans Photos, touchez Partager, Options, Le plus compatible, puis partagez à nouveau l’image avec BlueWallet." } }
      }
    },
    "share_recovery_unsupported_image" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "In Photos, select exactly one image, tap Share, then choose BlueWallet. Do not select a video or multiple items." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "En Fotos, selecciona exactamente una imagen, toca Compartir y elige BlueWallet. No selecciones un vídeo ni varios elementos." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Dans Photos, sélectionnez une seule image, touchez Partager, puis choisissez BlueWallet. Ne sélectionnez pas de vidéo ni plusieurs éléments." } }
      }
    }
  },
  "version" : "1.1"
}
