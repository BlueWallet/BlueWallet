require 'json'
require 'securerandom'
require 'tmpdir'

default_platform(:ios)
PROJECT_ROOT = File.expand_path("..", __dir__)

def write_github_output(hash)
  return unless ENV['GITHUB_OUTPUT'] && !ENV['GITHUB_OUTPUT'].empty?

  File.open(ENV['GITHUB_OUTPUT'], 'a') do |f|
    hash.each { |key, value| f.puts("#{key}=#{value}") }
  end
end

%w[android apple_signing ios_release catalyst release_notes].each do |name|
  import "lanes/#{name}.rb"
end
