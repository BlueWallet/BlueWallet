<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/shared_qr_preview"
            android:layout_width="252dp"
            android:layout_height="252dp"
            android:adjustViewBounds="true"
            android:background="@drawable/shared_qr_preview_background"
            android:clipToOutline="true"
            android:contentDescription="@string/shared_image_qr_preview"
            android:elevation="4dp"
            android:padding="6dp"
            android:scaleType="fitCenter" />

        <FrameLayout
            android:id="@+id/shared_address_deck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/shared_qr_content"
            style="@style/TextAppearance.MaterialComponents.Body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:minHeight="48dp"
            android:textAlignment="center"
            android:textColor="?android:attr/textColorSecondary"
            android:textIsSelectable="true" />

        <RadioGroup
            android:id="@+id/shared_qr_choices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
