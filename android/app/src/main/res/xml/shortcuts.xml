        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="io.bluewallet.bluewallet"
            android:targetClass="io.bluewallet.bluewallet.MainActivity"
            android:data="bluewallet://scan" />
    </shortcut>
    <shortcut
        android:shortcutId="manage_wallets"
