<?xml version="1.0" encoding="utf-8"?>
<!-- Neurai Market widget (receiver .MarketWidget). Fetched by NeuraiWidgetWorker; the system's update every 30 minutes only redraws (marks old data, also offline). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/market_widget_description"
    android:initialKeyguardLayout="@layout/widget_market"
    android:initialLayout="@layout/widget_market"
    android:maxResizeHeight="240dp"
    android:maxResizeWidth="320dp"
    android:minHeight="110dp"
    android:minResizeHeight="110dp"
    android:minResizeWidth="170dp"
    android:minWidth="170dp"
    android:previewImage="@drawable/market_widget_preview"
    android:previewLayout="@layout/widget_market_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen|keyguard" />
